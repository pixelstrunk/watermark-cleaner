#!/usr/bin/env bash
set -euo pipefail

if ! command -v wmc >/dev/null 2>&1; then
  echo "wmc: not installed, skipping clean (pip install wmc-cleaner)"
  exit 0
fi

files=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -Ei '\.(md|mdx|markdown|txt|html?|svg|png|jpe?g|webp|gif)$' || true)

if [ -z "$files" ]; then
  exit 0
fi

cleaned=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  wmc fix "$f" --no-voice --no-backup --quiet >/dev/null
  git add "$f"
  cleaned=$((cleaned + 1))
done <<< "$files"

if [ "$cleaned" -gt 0 ]; then
  echo "wmc: cleaned $cleaned staged file(s)"
fi
