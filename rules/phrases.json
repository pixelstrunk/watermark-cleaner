  "sentence_shapes": [
    { "id": "this-isnt-this-is", "pattern": "this\\s+is\\s?n['’]?t\\b[^.!?]{0,80}[.!?]\\s+this\\s+is\\b", "example": "This isn't a tool. This is a movement." },
    { "id": "its-not-just-its-about", "pattern": "it['’]?s\\s+not\\s+just\\s+about\\b[^.!?]{0,80},\\s*it['’]?s\\s+about\\b", "example": "It's not just about code, it's about craft." },
    { "id": "its-not-just-its-also", "pattern": "it['’]?s\\s+not\\s+just\\b[^.!?]{0,80},\\s*it['’]?s\\s+also\\b", "example": "It's not just planning, it's also psychology." },
    { "id": "not-only-but-also", "pattern": "\\bnot\\s+only\\b[^.!?]{0,80}\\bbut\\s+also\\b", "example": "Not only fast, but also reliable." },
    { "id": "stop-thinking-start-thinking", "pattern": "\\bstop\\s+thinking\\b[^.!?]{0,60}\\bstart\\s+thinking\\b", "example": "Stop thinking features. Start thinking jobs." },
    { "id": "is-dead-is-the-future", "pattern": "\\bis\\s+dead\\b[^.!?]{0,60}\\bis\\s+the\\s+future\\b", "example": "Agile is dead. Flow is the future." },
    { "id": "the-question-isnt", "pattern": "the\\s+question\\s+is\\s?n['’]?t\\b[^.!?]{0,80}the\\s+question\\s+is\\b", "example": "The question isn't how. The question is why." },
    { "id": "you-dont-need-you-need", "pattern": "\\byou\\s+do\\s?n['’]?t\\s+need\\b[^.!?]{0,60}\\byou\\s+need\\b", "example": "You don't need more tools. You need focus." },
    { "id": "isnt-merely-its", "pattern": "is\\s?n['’]?t\\s+merely\\b[^.!?]{0,80}it['’]?s\\b", "example": "This isn't merely a method, it's a worldview." },
    { "id": "this-is-where-comes-in", "pattern": "this\\s+is\\s+where\\b[^.!?]{0,60}\\bcomes\\s+in\\b", "example": "This is where user story mapping comes in." },
    { "id": "less-x-more-y", "pattern": "\\bless\\s+\\w+,\\s+more\\s+\\w+\\b", "example": "Less talking, more shipping." }
  ],
